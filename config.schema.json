{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWidget configuration",
  "type": "object",
  "properties": {
    "CoolingAndPower": { "$ref": "#/$defs/coolingAndPower" },
    "Peripherals": { "$ref": "#/$defs/peripherals" },
    "Accessories": { "$ref": "#/$defs/accessories" },
    "Widget": { "$ref": "#/$defs/widget" },
    "Widgets": { "$ref": "#/$defs/widgets" },
    "TelemetryWidget": { "$ref": "#/$defs/enabledLayout" },
    "FinanceWidget": { "$ref": "#/$defs/enabledLayout" },
    "Prices": { "$ref": "#/$defs/prices" },
    "PriceProvider": { "$ref": "#/$defs/priceProvider" },
    "HardwareVisibility": { "$ref": "#/$defs/hardwareVisibility" },
    "ManualHardware": {
      "type": "array",
      "items": { "$ref": "#/$defs/manualHardware" }
    },
    "HiddenHardware": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Stable category and item keys hidden from the detected hardware list."
    },
    "HardwareLinks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://(www\\.)?amazon\\.com\\.tr/"
      },
      "description": "Amazon.com.tr links overridden for detected hardware items."
    }
  },
  "$defs": {
    "coolingAndPower": {
      "type": "object",
      "properties": {
        "PcCase": { "type": ["string", "null"] },
        "CpuCooler": { "type": ["string", "null"] },
        "Psu": { "type": ["string", "null"] }
      }
    },
    "peripherals": {
      "type": "object",
      "properties": {
        "Keyboard": { "type": ["string", "null"] },
        "Mouse": { "type": ["string", "null"] },
        "Mousepad": { "type": ["string", "null"] },
        "Headset": { "type": ["string", "null"] },
        "Microphone": { "type": ["string", "null"] },
        "Monitor": { "type": ["string", "null"] }
      }
    },
    "accessories": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "widget": {
      "type": "object",
      "properties": {
        "Opacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "CustomLeft": { "type": ["number", "null"] },
        "CustomTop": { "type": ["number", "null"] },
        "AlwaysOnTop": { "type": "boolean" },
        "PinToDesktop": { "type": "boolean" },
        "AutoGameMode": { "type": "boolean" },
        "IsLocked": { "type": "boolean" },
        "IsCompact": { "type": "boolean" },
        "UseModularCards": { "type": "boolean" },
        "LimitClipboardHeight": { "type": "boolean" },
        "ClipboardHeight": { "type": "number", "minimum": 120, "maximum": 2000 },
        "IsClipboardHistoryExpanded": { "type": "boolean" },
        "Language": { "type": "string", "enum": ["tr", "en", "de", "fr", "es", "it", "pt", "ja", "ru"] },
        "City": { "type": "string" },
        "AccentTheme": { "type": "string" },
        "Currency": { "type": "string", "enum": ["TRY", "USD", "EUR", "GBP", "JPY", "CHF", "CAD", "AUD"] }
      }
    },
    "widgets": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "enabledLayout": {
      "type": "object",
      "properties": {
        "Enabled": { "type": "boolean" },
        "OffsetX": { "type": "number" },
        "OffsetY": { "type": "number" },
        "Width": { "type": "number" }
      }
    },
    "prices": {
      "type": "object",
      "properties": {
        "Source": { "type": "string" },
        "LastUpdated": { "type": "string", "format": "date" },
        "Currency": { "type": "string" },
        "Items": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "Entries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/priceEntry" }
        }
      }
    },
    "priceEntry": {
      "type": "object",
      "required": ["Value", "Status"],
      "properties": {
        "Value": { "type": "number", "minimum": 0 },
        "Currency": { "type": "string" },
        "Source": { "type": "string" },
        "Status": { "type": "string", "enum": ["Estimated", "Manual", "Live", "Stale", "Unavailable"] },
        "ProductId": { "type": ["string", "null"] },
        "ProductUrl": { "type": ["string", "null"], "format": "uri" },
        "LastCheckedUtc": { "type": ["string", "null"], "format": "date-time" },
        "LastSuccessfulUpdateUtc": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "priceProvider": {
      "type": "object",
      "properties": {
        "Enabled": { "type": "boolean" },
        "Endpoint": { "type": "string", "format": "uri" },
        "TimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 60 },
        "MaxAgeHours": { "type": "integer", "minimum": 1, "maximum": 168 }
      }
    },
    "hardwareVisibility": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "manualHardware": {
      "type": "object",
      "required": ["Name", "Category", "AmazonUrl"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "Category": {
          "type": "string",
          "enum": ["CoreSystem", "Storage", "Peripherals", "CoolingAndPower", "Accessories"],
          "description": "Language-independent hardware category key. Display names are localized by the application."
        },
        "Price": { "type": "number", "minimum": 0 },
        "AmazonUrl": {
          "type": "string",
          "pattern": "^https://(www\\.)?amazon\\.com\\.tr/"
        }
      }
    }
  }
}

<Application x:Class="OpenWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenWidget"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#E60B0F19" />
                <Setter Property="Foreground" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#25FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontFamily" Value="Roboto, Segoe UI Variable Text, Segoe UI, sans-serif" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Roboto, Segoe UI Variable Text, Segoe UI, sans-serif" />
            </Style>

            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="Roboto, Segoe UI Variable Text, Segoe UI, sans-serif" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

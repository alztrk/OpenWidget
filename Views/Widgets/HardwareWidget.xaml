<UserControl x:Class="OpenWidget.Widgets.HardwareWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenWidget.Converters"
             Margin="0,0,0,10"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />

        <DataTemplate x:Key="GadgetRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Component Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0" />

                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="4,0,4,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHardwareTitle"
                           Text="Donanım"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Path x:Name="ArrowIcon"
                      Data="{StaticResource GeoCollapse}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="8" Height="8"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ContentPanel">
            <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />
            <ItemsControl ItemsSource="{Binding Specs.Storage}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />
            <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />
            <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />
            <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />
        </StackPanel>
    </StackPanel>
</UserControl>

<Window x:Class="OpenWidget.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWidget Ayarlar"
        Width="610"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource SettingsDialogBgBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Roboto, Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern Pill Tab Button Style -->
        <Style x:Key="PillTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch (Checkbox Template) -->
        <Style x:Key="LegacyToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0" />

                            <!-- Pill Switch Track & Thumb on Right -->
                            <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Background="#26FFFFFF"
                                        CornerRadius="11"
                                        BorderBrush="{StaticResource MasterHudBorderBrush}"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="#F8FAFC"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#090D16" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Buttons (Genişletilmiş ve Konforlu Buton Tasarımı) -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#090D16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="145" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleResetBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Trigger ToggleButton Style -->
        <Style x:Key="CityDropdownToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource MasterHudBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Opacity Preset Chip Button Style -->
        <Style x:Key="OpacityChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MasterHudBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="7,1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Frosted Acrylic Master Dialog Container -->
    <Border x:Name="MasterDialogBorder"
            Background="{StaticResource SettingsDialogBgBrush}"
            BorderBrush="{StaticResource MasterHudBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26,22"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel>
            <!-- Title Bar -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="OpenWidget Ayarlar"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button DockPanel.Dock="Right"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ComponentActionButton}"
                        Padding="0"
                        MinWidth="28"
                        Click="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </DockPanel>

            <!-- Navigation Tabs (Pill Bar) -->
            <Border Background="{StaticResource SectionBgBrush}" CornerRadius="9" Padding="4" Margin="0,0,0,18">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabBtnGeneral" Content="Genel" Style="{StaticResource PillTabStyle}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnWidgets" Content="Widgetlar" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnHardware" Content="Donanım" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnSystem" Content="Sistem &amp; Performans" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                </UniformGrid>
            </Border>

            <!-- ================= TAB 1: GENEL YAPILANDIRMA ================= -->
            <StackPanel x:Name="PanelGeneral">
                <!-- Arayüz Dili -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblLanguage" Text="Arayüz Dili" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Widget ve sistem sağ tık menülerinin dili" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="1" Style="{StaticResource ComponentComboBox}" VerticalAlignment="Center" PreviewMouseLeftButtonDown="ComponentComboBox_PreviewMouseLeftButtonDown">
                            <ComboBoxItem Content="Türkçe" Tag="tr" IsSelected="True" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Deutsch" Tag="de" />
                            <ComboBoxItem Content="Français" Tag="fr" />
                            <ComboBoxItem Content="Español" Tag="es" />
                            <ComboBoxItem Content="Italiano" Tag="it" />
                            <ComboBoxItem Content="Português" Tag="pt" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                            <ComboBoxItem Content="Русский" Tag="ru" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Hava Durumu Şehri (Tüm Dünya İlleri Dropdown ile Search ve Kategori/Thread Yapısı) -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock x:Name="LblCity" Text="Hava Durumu Konumu" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LblCityHelp" Text="Ülke ve il kategorilerinden seçin veya aratın" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Custom Dropdown Trigger Button & Popup -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleButton x:Name="BtnCityDropdown"
                                          Style="{StaticResource CityDropdownToggleStyle}"
                                          Click="BtnCityDropdown_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource GeoLocation}"
                                          Fill="{StaticResource AccentBrush}"
                                          Stretch="Uniform"
                                          Width="11" Height="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtSelectedCity"
                                               Grid.Column="1"
                                               Text="Otomatik Algıla (IP)"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Path Grid.Column="2"
                                          Data="M7 10l5 5 5-5z"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Stretch="Uniform"
                                          Width="9" Height="9"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0" />
                                </Grid>
                            </ToggleButton>

                            <!-- Acrylic Dropdown Popup with Search Box & Threaded Country/City Categories -->
                            <Popup x:Name="PopupCityDirectory"
                                   PlacementTarget="{Binding ElementName=BtnCityDropdown}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4"
                                   Closed="PopupCityDirectory_Closed">
                                <Border Width="260"
                                        MaxHeight="360"
                                        Background="#F5090D16"
                                        BorderBrush="{StaticResource MasterHudBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,8,8,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.65" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Search Input Inside Dropdown -->
                                        <Border Grid.Row="0"
                                                Background="#1AFFFFFF"
                                                BorderBrush="{StaticResource MasterHudBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Height="32"
                                                Margin="0,0,0,8"
                                                Padding="8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="{StaticResource GeoSearch}"
                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                      Stretch="Uniform"
                                                      Width="11" Height="11"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtCitySearch"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         CaretBrush="{StaticResource AccentBrush}"
                                                         FontSize="11.5"
                                                         VerticalAlignment="Center"
                                                         TextChanged="TxtCitySearch_TextChanged" />
                                                <TextBlock x:Name="TxtSearchPlaceholder"
                                                           Grid.Column="1"
                                                           Text="Şehir veya ülke ara..."
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11.5"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Special Top Item: Auto Detect IP -->
                                        <Border Grid.Row="1"
                                                x:Name="BtnAutoDetectCity"
                                                Background="#1038BDF8"
                                                BorderBrush="#2038BDF8"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,0,0,6"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="BtnAutoDetectCity_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2538BDF8" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left"
                                                      Data="{StaticResource GeoLocation}"
                                                      Fill="{StaticResource AccentBrush}"
                                                      Stretch="Uniform"
                                                      Width="11" Height="11"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                                <TextBlock Text="Otomatik Algıla (IP Konumu)"
                                                           FontSize="11.5"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>

                                        <!-- Threaded Countries & Cities List -->
                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      SnapsToDevicePixels="True">
                                            <ItemsControl x:Name="ListCountryGroups">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2,0,8">
                                                            <!-- Country Category Header -->
                                                            <Border Background="{StaticResource SectionBgBrush}"
                                                                    CornerRadius="5"
                                                                    Padding="8,5"
                                                                    Margin="0,0,0,3">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding CountryName}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Cities.Count, StringFormat='({0})'}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" />
                                                                </DockPanel>
                                                            </Border>

                                                            <!-- Thread Indented Cities -->
                                                            <Grid Margin="6,0,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Vertical Thread Guide Line -->
                                                                <Border Grid.Column="0"
                                                                        Width="1"
                                                                        Background="#25FFFFFF"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="5,2,0,4" />

                                                                <!-- List of Cities in Country -->
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cities}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="Transparent"
                                                                                    CornerRadius="5"
                                                                                    Padding="8,5"
                                                                                    Margin="0,1"
                                                                                    Cursor="Hand"
                                                                                    MouseLeftButtonDown="CityRow_MouseLeftButtonDown">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#22FFFFFF" />
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <!-- Branch Dot -->
                                                                                    <Ellipse Grid.Column="0"
                                                                                             Width="4" Height="4"
                                                                                             Fill="{StaticResource TextMutedBrush}"
                                                                                             VerticalAlignment="Center"
                                                                                             Margin="0,0,8,0" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding}"
                                                                                               FontSize="11.5"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pencere Opaklığı (Özel Akrilik Slider & Ön Tanımlı Hızlı Butonlar) -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock x:Name="LblOpacity" Text="Pencere Opaklığı" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Cam yüzeyin saydamlık ve opaklık seviyesi" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <Slider x:Name="SliderOpacity"
                                        Minimum="30" Maximum="100" Value="100"
                                        VerticalAlignment="Center"
                                        Margin="0,0,48,0"
                                        ValueChanged="SliderOpacity_ValueChanged" />
                                <Border Background="#18FFFFFF"
                                        BorderBrush="{StaticResource MasterHudBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,2.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtOpacityValue" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <!-- Quick Select Percentage Chips -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="50%" Style="{StaticResource OpacityChipBtn}" Click="BtnOpacityPreset_Click" Tag="50" Margin="0,0,4,0" />
                                <Button Content="75%" Style="{StaticResource OpacityChipBtn}" Click="BtnOpacityPreset_Click" Tag="75" Margin="0,0,4,0" />
                                <Button Content="90%" Style="{StaticResource OpacityChipBtn}" Click="BtnOpacityPreset_Click" Tag="90" Margin="0,0,4,0" />
                                <Button Content="100%" Style="{StaticResource OpacityChipBtn}" Click="BtnOpacityPreset_Click" Tag="100" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Vurgu Teması -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblAccent" Text="Vurgu Rengi Teması" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Sistem grafikleri ve buton vurguları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbAccent" Grid.Column="1" Style="{StaticResource ComponentComboBox}" VerticalAlignment="Center" PreviewMouseLeftButtonDown="ComponentComboBox_PreviewMouseLeftButtonDown">
                            <ComboBoxItem Content="Sky (Mavi)" Tag="Sky" IsSelected="True" />
                            <ComboBoxItem Content="Emerald (Yeşil)" Tag="Emerald" />
                            <ComboBoxItem Content="Amber (Sarı)" Tag="Amber" />
                            <ComboBoxItem Content="Rose (Gül)" Tag="Rose" />
                            <ComboBoxItem Content="Purple (Mor)" Tag="Purple" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Görünüm Düzeni (Özel RadioButton Bileşeni) -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="Varsayılan Görünüm Düzeni" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Tam genişlikli HUD paneli veya minimal tek satır" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioModeFull" Content="Tam HUD" GroupName="LayoutRadioGroup" Style="{StaticResource ModernRadioButton}" Margin="0,0,16,0" IsChecked="True" />
                            <RadioButton x:Name="RadioModeCompact" Content="Kompakt HUD" GroupName="LayoutRadioGroup" Style="{StaticResource ModernRadioButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= TAB 2: WİDGETLAR ================= -->
            <StackPanel x:Name="PanelWidgets" Visibility="Collapsed" Margin="0,0,0,18">
                <Border Style="{StaticResource ComponentCard}" Padding="18,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkHeader" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Saat &amp; Sistem Durumu Çubuğu" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Canlı saat, tarih, oyun modu ve açık kalma süresi çubuğu" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkWeather" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Detaylı Hava Durumu Kartı" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Anlık sıcaklık, hissedilen, nem, rüzgar ve 3 günlük tahmin" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkTelemetry" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Sistem Telemetrisi" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="İşlemci, Ekran Kartı, RAM, Ağ trafiği ve Disk doluluğu" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkFinance" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Canlı Piyasa &amp; Kripto" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Dolar, Euro, Gram Altın, Bitcoin ve Ethereum kurları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkMedia" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Medya Oynatıcı (Now Playing)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Spotify, YouTube ve tarayıcı ses oturumu kontrolleri" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkClipboard" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Windows Pano Geçmişi Kartı" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Son kopyalanan metinleri listeleyen ve tek tıkla geri yükleyen pano kartı" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkHardware" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Donanım Özellikleri &amp; Fiyatlar" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Sistem bileşen listesi ve anlık donanım fiyat özeti" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkQuickActions" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Hızlı Araç Çubuğu" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Görev yöneticisi, ses, terminal ve bellek temizleme kısayolları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= TAB 3: DONANIM ================= -->
            <StackPanel x:Name="PanelHardware" Visibility="Collapsed" Margin="0,0,0,18">
                <Border Style="{StaticResource ComponentCard}" Padding="18,10">
                    <StackPanel>
                        <TextBlock x:Name="LblHardwareCategories" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkHardwareCore" Content="İşlemci, ekran kartı, anakart ve RAM" Style="{StaticResource ComponentToggle}" />
                        <CheckBox x:Name="ChkHardwareStorage" Content="Depolama" Style="{StaticResource ComponentToggle}" />
                        <CheckBox x:Name="ChkHardwarePeripherals" Content="Çevre birimleri" Style="{StaticResource ComponentToggle}" />
                        <CheckBox x:Name="ChkHardwareCooling" Content="Soğutma ve güç" Style="{StaticResource ComponentToggle}" />
                        <CheckBox x:Name="ChkHardwareAccessories" Content="Aksesuarlar" Style="{StaticResource ComponentToggle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ComponentCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblCurrentHardware" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LblCurrentHardwareHelp" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,8" />
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListHardware">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComponentCard}" Padding="10" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.ColumnSpan="2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Sil" Tag="{Binding}" Style="{StaticResource ComponentActionButton}" MinWidth="48" Padding="8,0" Click="BtnRemoveHardwareCard_Click" />
                                            </StackPanel>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ComponentCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblAddHardware" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LblAddHardwareHelp" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock x:Name="LblHardwareName" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="2,0,0,3" />
                                <TextBox x:Name="TxtHardwareName" Style="{StaticResource ComponentTextBox}" ToolTip="Ürün adı" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock x:Name="LblHardwareCategory" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="2,0,0,3" />
                                <ComboBox x:Name="CmbHardwareCategory" Style="{StaticResource ComponentComboBox}" PreviewMouseLeftButtonDown="ComponentComboBox_PreviewMouseLeftButtonDown">
                                    <ComboBoxItem x:Name="HardwareCategoryAccessories" Tag="Accessories" IsSelected="True" />
                                    <ComboBoxItem x:Name="HardwareCategoryCoreSystem" Tag="CoreSystem" />
                                    <ComboBoxItem x:Name="HardwareCategoryStorage" Tag="Storage" />
                                    <ComboBoxItem x:Name="HardwareCategoryPeripherals" Tag="Peripherals" />
                                    <ComboBoxItem x:Name="HardwareCategoryCoolingAndPower" Tag="CoolingAndPower" />
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Ekle" Style="{StaticResource ComponentActionButton}" VerticalAlignment="Bottom" Click="BtnAddHardware_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= TAB 4: SİSTEM & PERFORMANS ================= -->
            <StackPanel x:Name="PanelSystem" Visibility="Collapsed" Margin="0,0,0,18">
                <Border Style="{StaticResource ComponentCard}" Padding="18,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkLockPosition" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Widget Konumunu Kilitle" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Masaüstünde kazara sürüklenmeyi tamamen engeller" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkPinToDesktop" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Masaüstü Arkasına Sabitle" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Pencerelerin en arkasında kalır, işlerinizi engellemez" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Her Zaman Üstte Tut" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Diğer pencerelerin her zaman önünde görünür" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkAutoStart" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Windows ile Birlikte Başlat" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Bilgisayar açılışında arka planda otomatik başlar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkGameMode" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Oyun Modu (Otomatik Rölanti)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Tam ekran oyunlarda telemetri yenilemesini düşürür" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />
                        <CheckBox x:Name="ChkModularCards" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Modüler kart düzeni" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Widget bölümlerini ayrı kartlar halinde gösterir" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />
                        <CheckBox x:Name="ChkClipboardHeight" Style="{StaticResource ComponentToggle}">
                            <StackPanel>
                                <TextBlock Text="Pano kartı yüksekliğini sınırla" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Kapalı olduğunda pano geçmişi tüm içeriğiyle açılır" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Sürüm ve Güncelleme Denetimi -->
                <Border Style="{StaticResource ComponentCard}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCurrentVersion" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="#2038BDF8" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="Portable" FontSize="10" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtUpdateStatus" Text="GitHub Releases üzerinden sürüm kontrolü yapabilirsiniz" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button x:Name="BtnCheckUpdate"
                                Grid.Column="1"
                                Content="Güncellemeleri Denetle"
                                Style="{StaticResource ComponentActionButton}"
                                Height="32"
                                MinWidth="130"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Click="BtnCheckUpdate_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom Actions Bar -->
            <Border BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <DockPanel>
                    <Button x:Name="BtnReset"
                            Content="Varsayılana Sıfırla"
                            DockPanel.Dock="Left"
                            Style="{StaticResource ComponentSubtleButton}"
                            Click="BtnReset_Click" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel"
                                Content="Vazgeç"
                                Style="{StaticResource ComponentActionButton}"
                                Margin="0,0,12,0"
                                Click="BtnClose_Click" />
                        <Button x:Name="BtnSave"
                                Content="Kaydet ve Uygula"
                                Style="{StaticResource ComponentPrimaryButton}"
                                Click="BtnSave_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

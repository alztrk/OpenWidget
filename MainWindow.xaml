<Window x:Class="RigBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge Desktop HUD"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:KeyToBrushConverter x:Key="BrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 1. Hardware Gadget Row Template -->
        <DataTemplate x:Key="GadgetRowTemplate">
            <Grid Margin="0,0.5,0,1.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="12"
                      Height="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Name & Subtitle / Link -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Value}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0.5,0,0">
                        <TextBlock Text="{Binding LinkDisplay}"
                                   DockPanel.Dock="Right"
                                   FontSize="9"
                                   Foreground="{StaticResource AccentBrush}"
                                   Cursor="Hand"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Tag="{Binding Url}"
                                   PreviewMouseLeftButtonDown="Link_PreviewMouseLeftButtonDown"
                                   MouseLeftButtonUp="Link_MouseLeftButtonUp"
                                   Visibility="{Binding Url, Converter={StaticResource StringToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SubValue}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SubValue, Converter={StaticResource StringToVis}}" />
                    </DockPanel>
                </StackPanel>

                <!-- Market Price -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PriceFormatted}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PriceBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- 2. Telemetry Row Template -->
        <DataTemplate x:Key="TelemetryRowTemplate">
            <StackPanel Margin="0,1,0,2.5">
                <Grid Margin="0,0,0,1.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="12"
                          Height="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Name & Subtext -->
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding SubText}"
                                   DockPanel.Dock="Right"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Main Stat / Percentage -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding MainText}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Progress Bar Track -->
                <Grid Height="3" Margin="18,0,0,0">
                    <Border Background="{StaticResource TrackBgBrush}" CornerRadius="1.5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Percentage, StringFormat='{}{0}*'}" />
                            <ColumnDefinition Width="{Binding RemainingPercentage, StringFormat='{}{0}*'}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                                CornerRadius="1.5" />
                    </Grid>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- 3. Finance Row Template -->
        <DataTemplate x:Key="FinanceRowTemplate">
            <Grid Margin="0,1,0,2.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="12"
                      Height="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Label -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0" />

                <!-- Price and Daily Change -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ValueFormatted}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PriceBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ChangeFormatted}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 4. Quick Toolbar Button Style -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuTelemetry" Header="📊 Performans ve Disk Widget'ı" IsCheckable="True" Click="MenuTelemetry_Click" />
            <MenuItem x:Name="MenuFinance" Header="💰 Döviz ve Altın Widget'ı" IsCheckable="True" Click="MenuFinance_Click" />
            <MenuItem x:Name="MenuAutoStart" Header="🚀 Windows ile Birlikte Başlat" IsCheckable="True" Click="MenuAutoStart_Click" />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="📌 Her Zaman Üstte" IsCheckable="True" Click="MenuAlwaysOnTop_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="🔄 Fiyatları ve Verileri Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="💰 Fiyat Dosyasını Aç (hardware-prices.json)" Click="MenuEditPrices_Click" />
            <MenuItem Header="⚙️ Donanım Ayarlarını Aç (hardware-config.json)" Click="MenuEditConfig_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Kapat" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Single Unified Vertical Stack (Stationary & Non-Scrolling) -->
    <StackPanel>

        <!-- CARD 1: SİSTEM TELEMETRİSİ -->
        <Border Visibility="{Binding IsTelemetryVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource GlassBgBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11,7"
                Margin="0,0,0,6">
            <StackPanel>
                <!-- Card Header -->
                <DockPanel Margin="0,0,0,4">
                    <Path Data="{StaticResource GeoPerformance}"
                          Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform"
                          Width="12"
                          Height="12"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <TextBlock Text="SİSTEM TELEMETRİSİ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Telemetry.UptimeText, StringFormat='Açık: {0}'}"
                               DockPanel.Dock="Right"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Performans (CPU, RAM, GPU, VRAM) -->
                <DockPanel Margin="0,1,0,2">
                    <TextBlock Text="PERFORMANS"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Telemetry.Performance}"
                              ItemTemplate="{StaticResource TelemetryRowTemplate}" />

                <!-- Depolama (C: & D: Diski) -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="DİSK DOLULUK"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Telemetry.Storage}"
                              ItemTemplate="{StaticResource TelemetryRowTemplate}" />
            </StackPanel>
        </Border>

        <!-- CARD 2: CANLI PİYASA (DÖVİZ & ALTIN) -->
        <Border Visibility="{Binding IsFinanceVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource GlassBgBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11,7"
                Margin="0,0,0,6">
            <StackPanel>
                <!-- Card Header -->
                <DockPanel Margin="0,0,0,4">
                    <Path Data="{StaticResource GeoDollar}"
                          Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform"
                          Width="12"
                          Height="12"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <TextBlock Text="CANLI PİYASA"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Finance.WeatherText}"
                               DockPanel.Dock="Right"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Döviz Kurları -->
                <DockPanel Margin="0,1,0,2">
                    <TextBlock Text="DÖVİZ"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Finance.Currencies}"
                              ItemTemplate="{StaticResource FinanceRowTemplate}" />

                <!-- Altın Fiyatları -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="ALTIN"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Finance.Gold}"
                              ItemTemplate="{StaticResource FinanceRowTemplate}" />
            </StackPanel>
        </Border>

        <!-- CARD 3: DONANIM VE BİLEŞENLER (KOMPAKT) -->
        <Border Background="{StaticResource GlassBgBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11,7">
            <StackPanel>
                <!-- Card Header -->
                <DockPanel Margin="0,0,0,3">
                    <Path Data="{StaticResource GeoCpu}"
                          Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform"
                          Width="12"
                          Height="12"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <TextBlock Text="DONANIM BİLEŞENLERİ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- 1. SİSTEM -->
                <DockPanel Margin="0,1.5,0,2">
                    <TextBlock Text="SİSTEM"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />

                <!-- 2. DEPOLAMA -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="DEPOLAMA"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Specs.Storage}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />

                <!-- 3. ÇEVRE BİRİMLERİ -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="ÇEVRE BİRİMLERİ"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />

                <!-- 4. KASA, SOĞUTMA VE GÜÇ -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="KASA, SOĞUTMA VE GÜÇ"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />

                <!-- 5. AKSESUAR VE EKİPMAN -->
                <DockPanel Margin="0,3,0,2">
                    <TextBlock Text="AKSESUAR VE EKİPMAN"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />

                <!-- 6. TOPLAM DEĞER -->
                <Border Background="{StaticResource GlassCardBgBrush}"
                        BorderBrush="{StaticResource GlassCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,3.5,0,0"
                        Padding="8,3.5">
                    <TextBlock Text="{Binding Specs.TotalPriceFormatted}"
                               FontSize="14"
                               FontWeight="Heavy"
                               Foreground="{StaticResource AccentGreenBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

            </StackPanel>
        </Border>

        <!-- CARD 4: HIZLI SİSTEM ARAÇLARI (QUICK ACTIONS TOOLBAR) -->
        <Border Background="{StaticResource GlassBgBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,5"
                Margin="0,6,0,0">
            <UniformGrid Columns="4">
                <!-- Button 1: Task Manager -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="0,0,3,0"
                        ToolTip="Görev Yöneticisi (Ctrl+Shift+Esc)"
                        Click="BtnTaskMgr_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoTaskmgr}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Görev Yön." FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Button 2: Volume Mixer -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,3,0"
                        ToolTip="Ses Düzeyi Karıştırıcısı"
                        Click="BtnVolume_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoSpeaker}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Ses" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Button 3: Terminal -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,3,0"
                        ToolTip="Windows Terminal / PowerShell"
                        Click="BtnTerminal_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoTerminal}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Terminal" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Button 4: Clean RAM -->
                <Button x:Name="BtnCleanRam"
                        Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,0,0"
                        ToolTip="Çalışma Kümesini ve Belleği Temizle"
                        Click="BtnCleanRam_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoClean}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="TxtCleanRam" Text="Bellek Boşalt" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </StackPanel>
</Window>

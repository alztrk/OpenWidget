<Window x:Class="RigBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge"
        Width="380"
        Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Thin Minimalist Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#38404B" Opacity="0.8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Control Button Style -->
        <Style x:Key="HeaderActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D333B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38404B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hardware Item Template -->
        <DataTemplate x:Key="HardwareItemTemplate">
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,5"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0"
                            Width="24"
                            Height="24"
                            CornerRadius="5"
                            Background="#1A2230"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                              Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform"
                              Width="12"
                              Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Value}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                        <TextBlock Text="{Binding SubValue}"
                                   FontSize="9.5"
                                   Foreground="#7D8590"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   Visibility="{Binding SubValue, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="📌 Konumu Kilitle / Çöz" Click="MenuTogglePin_Click" />
            <MenuItem Header="🔄 Bilgileri Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="⚙️ Ayar Dosyasını Aç (config.json)" Click="MenuEditConfig_Click" />
            <Separator Background="#30363D" />
            <MenuItem Header="❌ Kapat" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Outer Container with Drop Shadow -->
    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              Color="#000000"
                              Opacity="0.6"
                              ShadowDepth="5" />
        </Border.Effect>

        <!-- Main Card Body -->
        <Border Background="{StaticResource WidgetBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0"
                        Background="#0D1117"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,8,0" />
                            <TextBlock Text="RIG BADGE"
                                       FontSize="11.5"
                                       FontWeight="Heavy"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="// DONANIM"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pin / Lock -->
                            <Button Style="{StaticResource HeaderActionBtn}"
                                    Click="MenuTogglePin_Click"
                                    ToolTip="Konumu Kilitle / Taşı">
                                <Path x:Name="PinIconPath"
                                      Data="{StaticResource GeoPin}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="11" />
                            </Button>

                            <!-- Refresh -->
                            <Button Style="{StaticResource HeaderActionBtn}"
                                    Click="MenuRefresh_Click"
                                    ToolTip="Donanımları Yeniden Tara">
                                <Path Data="{StaticResource GeoRefresh}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="11" />
                            </Button>

                            <!-- Config -->
                            <Button Style="{StaticResource HeaderActionBtn}"
                                    Click="MenuEditConfig_Click"
                                    ToolTip="Yapılandırma Dosyasını Aç">
                                <Path Data="{StaticResource GeoSettings}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="11" />
                            </Button>

                            <!-- Close -->
                            <Button Style="{StaticResource HeaderActionBtn}"
                                    Click="MenuExit_Click"
                                    ToolTip="Widgetı Kapat">
                                <Path Data="{StaticResource GeoClose}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Width="10"
                                      Height="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Hardware Specs Content -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,10,14,10">
                    <StackPanel>

                        <!-- 1. SİSTEM -->
                        <TextBlock Text="SİSTEM BİLEŞENLERİ"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                                      ItemTemplate="{StaticResource HardwareItemTemplate}" />

                        <!-- 2. DEPOLAMA -->
                        <TextBlock Text="DEPOLAMA BİRİMLERİ"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,5,0,5" />
                        <ItemsControl ItemsSource="{Binding Specs.Storage}"
                                      ItemTemplate="{StaticResource HardwareItemTemplate}" />

                        <!-- 3. ÇEVRE BİRİMLERİ -->
                        <TextBlock Text="ÇEVRE BİRİMLERİ"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,5,0,5" />
                        <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                                      ItemTemplate="{StaticResource HardwareItemTemplate}" />

                        <!-- 4. SOĞUTMA VE GÜÇ -->
                        <TextBlock Text="SOĞUTMA VE GÜÇ"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,5,0,5" />
                        <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                                      ItemTemplate="{StaticResource HardwareItemTemplate}" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>

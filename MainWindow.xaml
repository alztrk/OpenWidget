<Window x:Class="RigBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Minimalist Matte Black Row Template -->
        <DataTemplate x:Key="GadgetRowTemplate">
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon (Enlarged Refined Modern Vector) -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="15"
                      Height="15"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Names, Subtitles & Product Link -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Value}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubValue}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SubValue, Converter={StaticResource StringToVis}}" />
                    <!-- Clickable Product Link -->
                    <TextBlock Text="{Binding LinkDisplay}"
                               FontSize="9"
                               Foreground="{StaticResource AccentBrush}"
                               Cursor="Hand"
                               TextTrimming="CharacterEllipsis"
                               Tag="{Binding Url}"
                               PreviewMouseLeftButtonDown="Link_PreviewMouseLeftButtonDown"
                               MouseLeftButtonUp="Link_MouseLeftButtonUp"
                               Visibility="{Binding Url, Converter={StaticResource StringToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0.75" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Market Price -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PriceFormatted}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PriceBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuOnlyDesktop" Header="🖥️ Sadece Masaüstünde Göster" IsCheckable="True" Click="MenuOnlyDesktop_Click" />
            <MenuItem x:Name="MenuAutoStart" Header="🚀 Windows ile Birlikte Başlat" IsCheckable="True" Click="MenuAutoStart_Click" />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="📌 Her Zaman Üstte" IsCheckable="True" Click="MenuAlwaysOnTop_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="🔄 Fiyatları ve Donanımları Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="💰 Fiyat Dosyasını Aç (hardware-prices.json)" Click="MenuEditPrices_Click" />
            <MenuItem Header="⚙️ Donanım Ayarlarını Aç (hardware-config.json)" Click="MenuEditConfig_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Kapat" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Clean Solid Matte HUD Panel (Zero Extra Background, Margins or Shadows) -->
    <Border Background="{StaticResource GlassBgBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="13,12">
        <StackPanel>

            <!-- 1. SİSTEM -->
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="SİSTEM"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />

            <!-- 2. DEPOLAMA -->
            <DockPanel Margin="0,6,0,5">
                <TextBlock Text="DEPOLAMA"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Storage}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />

            <!-- 3. ÇEVRE BİRİMLERİ -->
            <DockPanel Margin="0,6,0,5">
                <TextBlock Text="ÇEVRE BİRİMLERİ"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />

            <!-- 4. KASA, SOĞUTMA VE GÜÇ -->
            <DockPanel Margin="0,6,0,5">
                <TextBlock Text="KASA, SOĞUTMA VE GÜÇ"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />

            <!-- 5. AKSESUAR VE EKİPMAN -->
            <DockPanel Margin="0,6,0,5">
                <TextBlock Text="AKSESUAR VE EKİPMAN"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                          ItemTemplate="{StaticResource GadgetRowTemplate}" />

            <!-- 6. TOPLAM DEĞER (MINIMAL MATTE BADGE) -->
            <Border Background="{StaticResource GlassCardBgBrush}"
                    BorderBrush="{StaticResource GlassCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Margin="0,8,0,0"
                    Padding="12,8">
                <TextBlock Text="{Binding Specs.TotalPriceFormatted}"
                           FontSize="16"
                           FontWeight="Heavy"
                           Foreground="{StaticResource AccentGreenBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

        </StackPanel>
    </Border>
</Window>

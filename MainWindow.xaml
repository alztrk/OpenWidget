<Window x:Class="RigBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:KeyToBrushConverter x:Key="BrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 1. Hardware Row Template (Modern Clean Single-Line) -->
        <DataTemplate x:Key="GadgetRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Component Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0" />

                    <!-- Price -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding PriceFormatted}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource PriceBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 2. Telemetry Row Template (Modern Inline Gauge) -->
        <DataTemplate x:Key="TelemetryRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Label & Details -->
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding SubText}"
                                   DockPanel.Dock="Right"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Inline Gauge + Value -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid Width="34" Height="3" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border Background="{StaticResource TrackBgBrush}" CornerRadius="1.5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Percentage, StringFormat='{}{0}*'}" />
                                    <ColumnDefinition Width="{Binding RemainingPercentage, StringFormat='{}{0}*'}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                                        CornerRadius="1.5" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding MainText}"
                                   Width="46"
                                   TextAlignment="Right"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 3. Finance Row Template (Modern Clean Ticker) -->
        <DataTemplate x:Key="FinanceRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Label -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,6,0" />

                    <!-- Price & Change -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ValueFormatted}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource PriceBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChangeFormatted}"
                                   Width="42"
                                   TextAlignment="Right"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 4. Modern Toolbar Button Style -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuTelemetry" Header="📊 Performans ve Disk" IsCheckable="True" Click="MenuTelemetry_Click" />
            <MenuItem x:Name="MenuFinance" Header="💰 Canlı Piyasa" IsCheckable="True" Click="MenuFinance_Click" />
            <MenuItem x:Name="MenuAutoStart" Header="🚀 Windows ile Birlikte Başlat" IsCheckable="True" Click="MenuAutoStart_Click" />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="📌 Her Zaman Üstte" IsCheckable="True" Click="MenuAlwaysOnTop_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="🔄 Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="⚙️ Ayarlar (hardware-config.json)" Click="MenuEditConfig_Click" />
            <MenuItem Header="💰 Fiyatlar (hardware-prices.json)" Click="MenuEditPrices_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Kapat" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Frosted Acrylic Master Surface -->
    <Border Background="{StaticResource MasterHudBgBrush}"
            BorderBrush="{StaticResource MasterHudBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,12">
        <StackPanel>

            <!-- Status Header Bar (Clean Minimal Strip) -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Finance.WeatherText}"
                           DockPanel.Dock="Left"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding Telemetry.UptimeText, StringFormat='Açık: {0}'}"
                           DockPanel.Dock="Right"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>

            <!-- 1. Telemetri Bölümü -->
            <StackPanel Visibility="{Binding IsTelemetryVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Telemetri"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,6" />
                <ItemsControl ItemsSource="{Binding Telemetry.Performance}"
                              ItemTemplate="{StaticResource TelemetryRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Telemetry.Storage}"
                              ItemTemplate="{StaticResource TelemetryRowTemplate}" />
            </StackPanel>

            <!-- 2. Piyasa Bölümü -->
            <StackPanel Visibility="{Binding IsFinanceVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Piyasa"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,6" />
                <ItemsControl ItemsSource="{Binding Finance.Currencies}"
                              ItemTemplate="{StaticResource FinanceRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Finance.Gold}"
                              ItemTemplate="{StaticResource FinanceRowTemplate}" />
            </StackPanel>

            <!-- 3. Donanım Bölümü -->
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="4,0,4,6">
                    <TextBlock Text="Donanım"
                               HorizontalAlignment="Left"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Specs.TotalPriceFormatted}"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGreenBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Specs.Storage}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />
                <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                              ItemTemplate="{StaticResource GadgetRowTemplate}" />
            </StackPanel>

            <!-- 4. Hızlı Kısayollar (Dock) -->
            <UniformGrid Columns="4" Margin="0,8,0,0">
                <!-- Görev Yöneticisi -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="0,0,3,0"
                        ToolTip="Görev Yöneticisi (Ctrl+Shift+Esc)"
                        Click="BtnTaskMgr_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoTaskmgr}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Görev Yön." FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Ses Karıştırıcısı -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,3,0"
                        ToolTip="Ses Düzeyi Karıştırıcısı"
                        Click="BtnVolume_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoSpeaker}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Ses" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Terminal -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,3,0"
                        ToolTip="Windows Terminal / PowerShell"
                        Click="BtnTerminal_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoTerminal}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Terminal" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Bellek Temizle -->
                <Button x:Name="BtnCleanRam"
                        Style="{StaticResource ToolbarBtnStyle}"
                        Margin="3,0,0,0"
                        ToolTip="Çalışma Kümesini ve Belleği Temizle"
                        Click="BtnCleanRam_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoClean}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock x:Name="TxtCleanRam" Text="Bellek Boşalt" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

        </StackPanel>
    </Border>
</Window>
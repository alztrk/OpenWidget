<Window x:Class="RigBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge Desktop HUD"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:KeyToBrushConverter x:Key="BrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 1. Hardware Gadget Row Template -->
        <DataTemplate x:Key="GadgetRowTemplate">
            <Grid Margin="0,0.5,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Name & Subtitle / Link -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Value}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0.5,0,0">
                        <TextBlock Text="{Binding LinkDisplay}"
                                   DockPanel.Dock="Right"
                                   FontSize="8.5"
                                   Foreground="{StaticResource AccentBrush}"
                                   Cursor="Hand"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Tag="{Binding Url}"
                                   PreviewMouseLeftButtonDown="Link_PreviewMouseLeftButtonDown"
                                   MouseLeftButtonUp="Link_MouseLeftButtonUp"
                                   Visibility="{Binding Url, Converter={StaticResource StringToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.9" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SubValue}"
                                   FontSize="8.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SubValue, Converter={StaticResource StringToVis}}" />
                    </DockPanel>
                </StackPanel>

                <!-- Market Price -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PriceFormatted}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Consolas, Segoe UI"
                           Foreground="{StaticResource PriceBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- 2. Telemetry Row Template (High-Precision Inline Gauge HUD) -->
        <DataTemplate x:Key="TelemetryRowTemplate">
            <Grid Margin="0,1.5,0,1.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Label & Subtext -->
                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding SubText}"
                               DockPanel.Dock="Right"
                               FontSize="8.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Label}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Inline Mini Bar + Tabular Value -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid Width="36" Height="3" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border Background="{StaticResource TrackBgBrush}" CornerRadius="1.5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Percentage, StringFormat='{}{0}*'}" />
                                <ColumnDefinition Width="{Binding RemainingPercentage, StringFormat='{}{0}*'}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                                    CornerRadius="1.5" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding MainText}"
                               Width="48"
                               TextAlignment="Right"
                               FontSize="11"
                               FontWeight="Bold"
                               FontFamily="Consolas, Segoe UI"
                               Foreground="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 3. Finance Row Template (Single-Line Precision Ticker) -->
        <DataTemplate x:Key="FinanceRowTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Label -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0" />

                <!-- Price & Change inline -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ValueFormatted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas, Segoe UI"
                               Foreground="{StaticResource PriceBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ChangeFormatted}"
                               Width="42"
                               TextAlignment="Right"
                               FontSize="9"
                               FontWeight="SemiBold"
                               FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 4. Quick Toolbar Button Style -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2DFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuTelemetry" Header="📊 Performans ve Disk Widget'ı" IsCheckable="True" Click="MenuTelemetry_Click" />
            <MenuItem x:Name="MenuFinance" Header="💰 Döviz ve Altın Widget'ı" IsCheckable="True" Click="MenuFinance_Click" />
            <MenuItem x:Name="MenuAutoStart" Header="🚀 Windows ile Birlikte Başlat" IsCheckable="True" Click="MenuAutoStart_Click" />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="📌 Her Zaman Üstte" IsCheckable="True" Click="MenuAlwaysOnTop_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="🔄 Fiyatları ve Verileri Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="💰 Fiyat Dosyasını Aç (hardware-prices.json)" Click="MenuEditPrices_Click" />
            <MenuItem Header="⚙️ Donanım Ayarlarını Aç (hardware-config.json)" Click="MenuEditConfig_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Kapat" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Master Unified HUD Chassis (Stationary & Non-Scrolling) -->
    <Border Background="{StaticResource MasterHudBgBrush}"
            BorderBrush="{StaticResource MasterHudBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="11,9">
        <StackPanel>

            <!-- 1. HUD TOP STATUS BAR (Host, Live Dot, Weather & Uptime) -->
            <DockPanel Margin="0,0,0,7">
                <!-- Left: Host & Live Status Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource AccentGreenBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,5,0" />
                    <TextBlock Text="RIGBADGE"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" // DESKTOP HUD"
                               FontSize="8.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Weather & Uptime Capsules -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Finance.WeatherText}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="5,1.5">
                        <TextBlock Text="{Binding Telemetry.UptimeText, StringFormat='Açık: {0}'}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- 2. SİSTEM TELEMETRİSİ PANELİ -->
            <Border Visibility="{Binding IsTelemetryVisible, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SectionBgBrush}"
                    BorderBrush="{StaticResource SectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="SİSTEM TELEMETRİSİ"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding Telemetry.Performance}"
                                  ItemTemplate="{StaticResource TelemetryRowTemplate}" />

                    <TextBlock Text="DİSK DOLULUK"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,2" />
                    <ItemsControl ItemsSource="{Binding Telemetry.Storage}"
                                  ItemTemplate="{StaticResource TelemetryRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- 3. CANLI PİYASA PANELİ -->
            <Border Visibility="{Binding IsFinanceVisible, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SectionBgBrush}"
                    BorderBrush="{StaticResource SectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,3">
                        <TextBlock Text="CANLI PİYASA"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentAmberBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Döviz &amp; Altın"
                                   FontSize="8"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="DÖVİZ"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,1,0,2" />
                    <ItemsControl ItemsSource="{Binding Finance.Currencies}"
                                  ItemTemplate="{StaticResource FinanceRowTemplate}" />

                    <TextBlock Text="ALTIN"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,2" />
                    <ItemsControl ItemsSource="{Binding Finance.Gold}"
                                  ItemTemplate="{StaticResource FinanceRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- 4. DONANIM BİLEŞENLERİ PANELİ -->
            <Border Background="{StaticResource SectionBgBrush}"
                    BorderBrush="{StaticResource SectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6">
                <StackPanel>
                    <!-- Header with Total Price -->
                    <DockPanel Margin="0,0,0,3">
                        <TextBlock Text="DONANIM BİLEŞENLERİ"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Specs.TotalPriceFormatted}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Çekirdek Sistem -->
                    <TextBlock Text="ÇEKİRDEK SİSTEM"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,1" />
                    <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                                  ItemTemplate="{StaticResource GadgetRowTemplate}" />

                    <!-- Depolama -->
                    <TextBlock Text="DEPOLAMA"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,1" />
                    <ItemsControl ItemsSource="{Binding Specs.Storage}"
                                  ItemTemplate="{StaticResource GadgetRowTemplate}" />

                    <!-- Çevre Birimleri -->
                    <TextBlock Text="ÇEVRE BİRİMLERİ"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,1" />
                    <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                                  ItemTemplate="{StaticResource GadgetRowTemplate}" />

                    <!-- Kasa, Soğutma & Güç -->
                    <TextBlock Text="KASA &amp; SOĞUTMA"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,1" />
                    <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                                  ItemTemplate="{StaticResource GadgetRowTemplate}" />

                    <!-- Aksesuar & Ekipman -->
                    <TextBlock Text="AKSESUAR"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,1" />
                    <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                                  ItemTemplate="{StaticResource GadgetRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- 5. HIZLI SİSTEM ARAÇLARI DOCK (QUICK ACTIONS TOOLBAR) -->
            <Border Margin="0,6,0,0">
                <UniformGrid Columns="4">
                    <!-- Button 1: Task Manager -->
                    <Button Style="{StaticResource ToolbarBtnStyle}"
                            Margin="0,0,2.5,0"
                            ToolTip="Görev Yöneticisi (Ctrl+Shift+Esc)"
                            Click="BtnTaskMgr_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoTaskmgr}"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center" Margin="0,0,3.5,0" />
                            <TextBlock Text="Görev Yön." FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 2: Volume Mixer -->
                    <Button Style="{StaticResource ToolbarBtnStyle}"
                            Margin="2.5,0,2.5,0"
                            ToolTip="Ses Düzeyi Karıştırıcısı"
                            Click="BtnVolume_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoSpeaker}"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center" Margin="0,0,3.5,0" />
                            <TextBlock Text="Ses" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 3: Terminal -->
                    <Button Style="{StaticResource ToolbarBtnStyle}"
                            Margin="2.5,0,2.5,0"
                            ToolTip="Windows Terminal / PowerShell"
                            Click="BtnTerminal_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoTerminal}"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center" Margin="0,0,3.5,0" />
                            <TextBlock Text="Terminal" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Button 4: Clean RAM -->
                    <Button x:Name="BtnCleanRam"
                            Style="{StaticResource ToolbarBtnStyle}"
                            Margin="2.5,0,0,0"
                            ToolTip="Çalışma Kümesini ve Belleği Temizle"
                            Click="BtnCleanRam_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoClean}"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center" Margin="0,0,3.5,0" />
                            <TextBlock x:Name="TxtCleanRam" Text="Bellek Boşalt" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

        </StackPanel>
    </Border>
</Window>
<Window x:Class="OpenWidget.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWidget Ayarlar"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Modern Pill Tab Button Style -->
        <Style x:Key="PillTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBd" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS/Fluent Pill Toggle Switch for CheckBox -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Label on Left with generous right margin -->
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0" />

                            <!-- Pill Switch Track & Thumb on Right -->
                            <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Background="#26FFFFFF"
                                        CornerRadius="11"
                                        BorderBrush="{StaticResource MasterHudBorderBrush}"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="#F8FAFC"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#090D16" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Minimalist TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MasterHudBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Buttons -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#090D16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleResetBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Frosted Acrylic Master Dialog Container -->
    <Border Background="{StaticResource MasterHudBgBrush}"
            BorderBrush="{StaticResource MasterHudBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26,22"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel>
            <!-- Title Bar -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#1C38BDF8" CornerRadius="7" Padding="7" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoPerformance}"
                              Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform"
                              Width="14" Height="14" />
                    </Border>
                    <TextBlock x:Name="TxtTitle"
                               Text="OpenWidget Ayarlar"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button DockPanel.Dock="Right"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostBtnStyle}"
                        Padding="0"
                        Click="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </DockPanel>

            <!-- Navigation Tabs (Pill Bar) -->
            <Border Background="#12FFFFFF" CornerRadius="9" Padding="4" Margin="0,0,0,18">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TabBtnGeneral" Content="Genel" Style="{StaticResource PillTabStyle}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnWidgets" Content="Widgetlar" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnSystem" Content="Sistem &amp; Performans" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                </UniformGrid>
            </Border>

            <!-- ================= TAB 1: GENEL YAPILANDIRMA ================= -->
            <StackPanel x:Name="PanelGeneral">
                <!-- Arayüz Dili -->
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblLanguage" Text="Arayüz Dili" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Widget ve sistem sağ tık menülerinin dili" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" VerticalAlignment="Center">
                            <ComboBoxItem Content="Türkçe" Tag="tr" IsSelected="True" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Hava Durumu Şehri (Otomatik Tamamlama ve Öneri Menüsü) -->
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblCity" Text="Hava Durumu Konumu" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LblCityHelp" Text="Yazmaya başlayarak şehri seçin veya boş bırakın" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCity"
                                     Style="{StaticResource ModernTextBox}"
                                     GotFocus="TxtCity_GotFocus"
                                     TextChanged="TxtCity_TextChanged"
                                     PreviewKeyDown="TxtCity_PreviewKeyDown" />

                            <!-- City Auto-Complete Suggestion Popup -->
                            <Popup x:Name="PopupCitySuggestions"
                                   PlacementTarget="{Binding ElementName=TxtCity}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border MinWidth="190"
                                        MaxHeight="200"
                                        Background="#F0090D16"
                                        BorderBrush="{StaticResource MasterHudBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.6" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True">
                                        <ItemsControl x:Name="ListCitySuggestions">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="10,6"
                                                            Cursor="Hand"
                                                            Margin="1"
                                                            MouseLeftButtonDown="CityItem_MouseLeftButtonDown">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#24FFFFFF" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path Data="{StaticResource GeoLocation}"
                                                                  Fill="{StaticResource AccentBrush}"
                                                                  Stretch="Uniform"
                                                                  Width="11" Height="11"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pencere Opaklığı -->
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblOpacity" Text="Pencere Opaklığı" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Cam yüzeyin saydamlık ve opaklık seviyesi" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Slider x:Name="SliderOpacity" Grid.Column="1" Minimum="30" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="SliderOpacity_ValueChanged" />
                        <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="5" Padding="5,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOpacityValue" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Vurgu Teması -->
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="LblAccent" Text="Vurgu Rengi Teması" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Sistem grafikleri ve buton vurguları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbAccent" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" VerticalAlignment="Center">
                            <ComboBoxItem Content="Sky (Mavi)" Tag="Sky" IsSelected="True" />
                            <ComboBoxItem Content="Emerald (Yeşil)" Tag="Emerald" />
                            <ComboBoxItem Content="Amber (Sarı)" Tag="Amber" />
                            <ComboBoxItem Content="Rose (Gül)" Tag="Rose" />
                            <ComboBoxItem Content="Purple (Mor)" Tag="Purple" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Görünüm Düzeni (Özel RadioButton Bileşeni) -->
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="Varsayılan Görünüm Düzeni" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Tam genişlikli HUD paneli veya minimal tek satır" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioModeFull" Content="Tam HUD" GroupName="LayoutRadioGroup" Style="{StaticResource ModernRadioButton}" Margin="0,0,16,0" IsChecked="True" />
                            <RadioButton x:Name="RadioModeCompact" Content="Kompakt HUD" GroupName="LayoutRadioGroup" Style="{StaticResource ModernRadioButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= TAB 2: WİDGETLAR ================= -->
            <StackPanel x:Name="PanelWidgets" Visibility="Collapsed" Margin="0,0,0,18">
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkHeader" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Hava Durumu &amp; Açık Kalma Süresi" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Konum bazlı anlık hava ve sistem açık kalma süresi" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkTelemetry" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Sistem Telemetrisi" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="İşlemci, Ekran Kartı, RAM, Ağ trafiği ve Disk doluluğu" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkFinance" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Canlı Piyasa &amp; Kripto" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Dolar, Euro, Gram Altın, Bitcoin ve Ethereum kurları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkMedia" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Medya Oynatıcı (Now Playing)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Spotify, YouTube ve tarayıcı ses oturumu kontrolleri" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkHardware" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Donanım Özellikleri &amp; Fiyatlar" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Sistem bileşen listesi ve anlık donanım fiyat özeti" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkQuickActions" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Hızlı Araç Çubuğu" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Görev yöneticisi, ses, terminal ve bellek temizleme kısayolları" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= TAB 3: SİSTEM & PERFORMANS ================= -->
            <StackPanel x:Name="PanelSystem" Visibility="Collapsed" Margin="0,0,0,18">
                <Border Background="#0EFFFFFF" BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkLockPosition" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Widget Konumunu Kilitle" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Masaüstünde kazara sürüklenmeyi tamamen engeller" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkPinToDesktop" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Masaüstü Arkasına Sabitle" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Pencerelerin en arkasında kalır, işlerinizi engellemez" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Her Zaman Üstte Tut" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Diğer pencerelerin her zaman önünde görünür" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkAutoStart" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Windows ile Birlikte Başlat" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Bilgisayar açılışında arka planda otomatik başlar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="{StaticResource MasterHudBorderBrush}" Margin="0,4" />

                        <CheckBox x:Name="ChkGameMode" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Oyun Modu (Otomatik Rölanti)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Tam ekran oyunlarda telemetri yenilemesini düşürür" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Actions Bar -->
            <Border BorderBrush="{StaticResource MasterHudBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <DockPanel>
                    <Button x:Name="BtnReset"
                            Content="Varsayılana Sıfırla"
                            DockPanel.Dock="Left"
                            Style="{StaticResource SubtleResetBtnStyle}"
                            Click="BtnReset_Click" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel"
                                Content="Vazgeç"
                                Style="{StaticResource GhostBtnStyle}"
                                Margin="0,0,10,0"
                                Click="BtnClose_Click" />
                        <Button x:Name="BtnSave"
                                Content="Kaydet ve Uygula"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Click="BtnSave_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
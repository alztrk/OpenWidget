<Window x:Class="OpenWidget.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWidget Ayarlar"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Modern Pill Tab Button Style -->
        <Style x:Key="PillTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBd" Property="Background" Value="#0FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS/Fluent Pill Toggle Switch for CheckBox -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Label on Left -->
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <!-- Pill Switch Track & Thumb on Right -->
                            <Grid Grid.Column="1" Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Background="#24FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="14" Height="14"
                                         Fill="#F8FAFC"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#0B0F17" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Minimalist TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Buttons -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#090D16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Frosted Acrylic Master Dialog Container -->
    <Border Background="#F4090D16"
            BorderBrush="{StaticResource MasterHudBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22,18"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel>
            <!-- Title Bar -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#1C38BDF8" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                        <Path Data="{StaticResource GeoPerformance}"
                              Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform"
                              Width="13" Height="13" />
                    </Border>
                    <TextBlock x:Name="TxtTitle"
                               Text="OpenWidget Ayarlar"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button DockPanel.Dock="Right"
                        Width="26" Height="26"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostBtnStyle}"
                        Padding="0"
                        Click="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </DockPanel>

            <!-- Navigation Tabs (Pill Bar) -->
            <Border Background="#10FFFFFF" CornerRadius="8" Padding="3" Margin="0,0,0,16">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TabBtnGeneral" Content="Genel" Style="{StaticResource PillTabStyle}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnWidgets" Content="Widgetlar" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabBtnSystem" Content="Sistem &amp; Performans" Style="{StaticResource PillTabStyle}" Checked="Tab_Checked" />
                </UniformGrid>
            </Border>

            <!-- ================= TAB 1: GENEL YAPILANDIRMA ================= -->
            <StackPanel x:Name="PanelGeneral">
                <!-- Arayüz Dili -->
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblLanguage" Text="Arayüz Dili" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Widget ve sistem menülerinin dili" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="1" Height="28" Background="#18FFFFFF" Foreground="#0B0F17" VerticalAlignment="Center">
                            <ComboBoxItem Content="Türkçe" Tag="tr" IsSelected="True" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Hava Durumu Şehri -->
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblCity" Text="Hava Durumu Konumu" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LblCityHelp" Text="Boş bırakırsanız IP üzerinden algılar" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox x:Name="TxtCity" Grid.Column="1" Height="28" Style="{StaticResource ModernTextBox}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Pencere Opaklığı -->
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblOpacity" Text="Pencere Opaklığı" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Cam yüzeyin şeffaflık seviyesi" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Slider x:Name="SliderOpacity" Grid.Column="1" Minimum="30" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="SliderOpacity_ValueChanged" />
                        <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOpacityValue" Text="100%" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Vurgu Teması -->
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblAccent" Text="Vurgu Rengi Teması" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Sistem grafikleri ve buton vurguları" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="CmbAccent" Grid.Column="1" Height="28" Background="#18FFFFFF" Foreground="#0B0F17" VerticalAlignment="Center">
                            <ComboBoxItem Content="Sky (Mavi)" Tag="Sky" IsSelected="True" />
                            <ComboBoxItem Content="Emerald (Yeşil)" Tag="Emerald" />
                            <ComboBoxItem Content="Amber (Sarı)" Tag="Amber" />
                            <ComboBoxItem Content="Rose (Gül)" Tag="Rose" />
                            <ComboBoxItem Content="Purple (Mor)" Tag="Purple" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= TAB 2: WİDGETLAR ================= -->
            <StackPanel x:Name="PanelWidgets" Visibility="Collapsed" Margin="0,0,0,16">
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,8">
                    <StackPanel>
                        <CheckBox x:Name="ChkHeader" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Hava Durumu &amp; Açık Kalma Süresi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Konum bazlı hava ve sistem çalışma süresi" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkTelemetry" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Sistem Telemetrisi" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="CPU, GPU, RAM, Ağ trafiği ve Disk doluluğu" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkFinance" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Canlı Piyasa &amp; Kripto" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Dolar, Euro, Gram Altın, Bitcoin ve Ethereum" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkMedia" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Medya Oynatıcı (Now Playing)" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Spotify, YouTube ve tarayıcı ses kontrolleri" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkHardware" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Donanım Özellikleri &amp; Fiyatlar" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Sistem bileşen listesi ve anlık donanım fiyatı" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkQuickActions" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Hızlı Araç Çubuğu" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Görev yöneticisi, ses, terminal ve RAM temizleme" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= TAB 3: SİSTEM & PERFORMANS ================= -->
            <StackPanel x:Name="PanelSystem" Visibility="Collapsed" Margin="0,0,0,16">
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="14,8">
                    <StackPanel>
                        <CheckBox x:Name="ChkCompactMode" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Kompakt HUD Modu" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Yalnızca 24px yüksekliğinde minimal özet şerit modu" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkLockPosition" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Widget Konumunu Kilitle" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Masaüstünde kazara sürüklenmeyi engeller" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkPinToDesktop" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Masaüstü Arkasına Sabitle" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Pencerelerin en arkasında kalır, işlerinizi engellemez" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Her Zaman Üstte Tut" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Diğer pencerelerin her zaman önünde görünür" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkAutoStart" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Windows ile Birlikte Başlat" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Bilgisayar açılışında arka planda otomatik başlar" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <Separator Background="#0DFFFFFF" Margin="0,3" />

                        <CheckBox x:Name="ChkGameMode" Style="{StaticResource ModernToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Oyun Modu (Otomatik Rölanti)" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Tam ekran oyunlarda telemetri yenilemesini düşürür" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Actions Bar -->
            <Border BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <DockPanel>
                    <Button x:Name="BtnReset"
                            Content="Varsayılana Sıfırla"
                            DockPanel.Dock="Left"
                            Style="{StaticResource GhostBtnStyle}"
                            Click="BtnReset_Click" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel"
                                Content="Vazgeç"
                                Style="{StaticResource GhostBtnStyle}"
                                Margin="0,0,8,0"
                                Click="BtnClose_Click" />
                        <Button x:Name="BtnSave"
                                Content="Kaydet ve Uygula"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Click="BtnSave_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
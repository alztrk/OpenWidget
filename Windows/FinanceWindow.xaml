<Window x:Class="RigBadge.Windows.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge Finance"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Finance Row Template -->
        <DataTemplate x:Key="FinanceRowTemplate">
            <Grid Margin="0,3,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path Grid.Column="0"
                      Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="13"
                      Height="13"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

                <!-- Label -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0" />

                <!-- Price and Daily Change -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ValueFormatted}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PriceBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="TxtChange"
                               Text="{Binding ChangeFormatted}"
                               FontSize="8.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                    <Setter TargetName="TxtChange" Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                    <Setter TargetName="TxtChange" Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="🔄 Kurları Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="⚙️ Konumu Sıfırla" Click="MenuResetPos_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Bu Widget'ı Kapat" Click="MenuClose_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Clean Solid Matte HUD Panel -->
    <Border Background="{StaticResource GlassBgBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,11">
        <StackPanel>

            <!-- 1. DÖVİZ KURLARI (USD & EUR) -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="DÖVİZ"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Currencies}"
                          ItemTemplate="{StaticResource FinanceRowTemplate}" />

            <!-- 2. ALTIN FİYATLARI (GRAM, ÇEYREK, TAM) -->
            <DockPanel Margin="0,5,0,4">
                <TextBlock Text="ALTIN"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Gold}"
                          ItemTemplate="{StaticResource FinanceRowTemplate}" />

            <!-- 3. FOOTER BADGE -->
            <Border Background="{StaticResource GlassCardBgBrush}"
                    BorderBrush="{StaticResource GlassCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,6,0,0"
                    Padding="8,4">
                <DockPanel>
                    <Border Width="4"
                            Height="4"
                            CornerRadius="2"
                            Background="{StaticResource AccentGreenBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0" />
                    <TextBlock Text="Piyasa Verileri"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Specs.LastUpdatedText}"
                               FontSize="8"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>

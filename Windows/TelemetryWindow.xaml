<Window x:Class="RigBadge.Windows.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RigBadge.Converters"
        Title="RigBadge Telemetry"
        Width="260"
        MinHeight="170"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
        <converters:KeyToBrushConverter x:Key="BrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Telemetry Row Template -->
        <DataTemplate x:Key="TelemetryRowTemplate">
            <StackPanel Margin="0,3,0,6">
                <!-- Label & Value -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="13"
                          Height="13"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Name & Subtext -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubText}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SubText, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <!-- Percentage / Main Stat -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding MainText}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Mini Progress Track -->
                <Grid Height="3.5" Margin="20,1,0,0">
                    <Border Background="{StaticResource TrackBgBrush}" CornerRadius="1.75" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Percentage, StringFormat='{}{0}*'}" />
                            <ColumnDefinition Width="{Binding RemainingPercentage, StringFormat='{}{0}*'}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{Binding BarColorKey, Converter={StaticResource BrushConverter}}"
                                CornerRadius="1.75" />
                    </Grid>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="🔄 Şimdi Yenile" Click="MenuRefresh_Click" />
            <MenuItem Header="⚙️ Konumu Sıfırla" Click="MenuResetPos_Click" />
            <Separator Background="{StaticResource DividerBrush}" />
            <MenuItem Header="❌ Bu Widget'ı Kapat" Click="MenuClose_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Clean Solid Matte HUD Panel -->
    <Border Background="{StaticResource GlassBgBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,11">
        <StackPanel>

            <!-- 1. PERFORMANS (CPU & RAM) -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="PERFORMANS"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Performance}"
                          ItemTemplate="{StaticResource TelemetryRowTemplate}" />

            <!-- 2. DEPOLAMA DOLULUK (C & D) -->
            <DockPanel Margin="0,5,0,4">
                <TextBlock Text="DİSK DOLULUK"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Specs.Storage}"
                          ItemTemplate="{StaticResource TelemetryRowTemplate}" />

        </StackPanel>
    </Border>
</Window>

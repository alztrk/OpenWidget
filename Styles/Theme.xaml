<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern 2026 Minimal Acrylic Dark Glass Theme -->
    <Color x:Key="MasterHudBgColor">#78080C14</Color>
    <SolidColorBrush x:Key="MasterHudBgBrush" Color="{StaticResource MasterHudBgColor}" />

    <Color x:Key="MasterHudBorderColor">#1CFFFFFF</Color>
    <SolidColorBrush x:Key="MasterHudBorderBrush" Color="{StaticResource MasterHudBorderColor}" />

    <Color x:Key="SectionBgColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="SectionBgBrush" Color="{StaticResource SectionBgColor}" />

    <Color x:Key="SectionBorderColor">#10FFFFFF</Color>
    <SolidColorBrush x:Key="SectionBorderBrush" Color="{StaticResource SectionBorderColor}" />

    <!-- Palette -->
    <Color x:Key="AccentColor">#38BDF8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <Color x:Key="AccentGreenColor">#34D399</Color>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />

    <Color x:Key="PriceColor">#93C5FD</Color>
    <SolidColorBrush x:Key="PriceBrush" Color="{StaticResource PriceColor}" />

    <Color x:Key="AccentRedColor">#F87171</Color>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />

    <Color x:Key="AccentAmberColor">#FBBF24</Color>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />

    <Color x:Key="TrackBgColor">#1AFFFFFF</Color>
    <SolidColorBrush x:Key="TrackBgBrush" Color="{StaticResource TrackBgColor}" />

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="DividerColor">#10FFFFFF</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Backward compatibility aliases -->
    <SolidColorBrush x:Key="GlassBgBrush" Color="{StaticResource MasterHudBgColor}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource MasterHudBorderColor}" />
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="{StaticResource SectionBgColor}" />
    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="{StaticResource SectionBorderColor}" />

    <!-- Modern Acrylic ContextMenu Styles -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#CC090D16" />
        <Setter Property="BorderBrush" Value="{StaticResource MasterHudBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="8,0"
                            Margin="1,0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Checkmark / Indicator -->
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M3.5 8.5l3 3 7-7"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Visibility="Collapsed"
                                  Width="11" Height="9" />

                            <!-- Header -->
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="2,0,8,0" />

                            <!-- Input Gesture -->
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


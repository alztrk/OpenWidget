    <!-- Pure Flat Matte Obsidian Black (Zero Glassmorphism) -->
    <Color x:Key="GlassBgColor">#0A0C10</Color>
    <SolidColorBrush x:Key="GlassBgBrush" Color="{StaticResource GlassBgColor}" />

    <Color x:Key="GlassBorderColor">#181C23</Color>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />

    <Color x:Key="GlassCardBgColor">#06080B</Color>
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="{StaticResource GlassCardBgColor}" />

    <Color x:Key="GlassCardBorderColor">#13171F</Color>
    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="{StaticResource GlassCardBorderColor}" />

    <Color x:Key="AccentColor">#539BF5</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <Color x:Key="AccentGreenColor">#3FB950</Color>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />

    <Color x:Key="PriceColor">#58A6FF</Color>
    <SolidColorBrush x:Key="PriceBrush" Color="{StaticResource PriceColor}" />

    <!-- Tuned Matte Typography Opacities -->
    <Color x:Key="TextPrimaryColor">#C9D1D9</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#7D8590</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#57606A</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="DividerColor">#13171F</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />


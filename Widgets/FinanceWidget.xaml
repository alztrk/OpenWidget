<UserControl x:Class="OpenWidget.Widgets.FinanceWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenWidget.Converters"
             Margin="0,0,0,14"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />

        <DataTemplate x:Key="FinanceRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Label -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,6,0" />

                    <!-- Price & Change -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ValueFormatted}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource PriceBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChangeFormatted}"
                                   Width="44"
                                   TextAlignment="Right"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="TxtTitle"
                   Text="Piyasa &amp; Kripto"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="4,0,0,6" />
        <ItemsControl ItemsSource="{Binding Finance.Currencies}"
                      ItemTemplate="{StaticResource FinanceRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Finance.Gold}"
                      ItemTemplate="{StaticResource FinanceRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Finance.Crypto}"
                      ItemTemplate="{StaticResource FinanceRowTemplate}" />
    </StackPanel>
</UserControl>
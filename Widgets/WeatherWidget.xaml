<UserControl x:Class="OpenWidget.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenWidget.Converters"
             Margin="0,0,0,14"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />
    </UserControl.Resources>

    <StackPanel>
        <!-- Header Row -->
        <Grid Margin="4,0,4,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource GeoWeather}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform"
                      Width="11" Height="11"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTitle"
                           Text="Hava Durumu"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="TxtCity"
                       Text="{Binding Weather.City}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Weather Card Surface -->
        <Border Background="{StaticResource SectionBgBrush}"
                BorderBrush="{StaticResource SectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <StackPanel>
                <!-- Current Weather Overview -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Temperature & Condition Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Weather.TempFormatted}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Weather.ConditionText}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,1.5,0,0">
                                <TextBlock x:Name="TxtFeelsLikeLabel"
                                           Text="Hissedilen "
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Weather.FeelsLikeFormatted}"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Condition Icon Badge -->
                    <Border Grid.Column="1"
                            Background="#1838BDF8"
                            CornerRadius="8"
                            Width="36" Height="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                        <Path Data="{Binding Weather.IconKey, Converter={StaticResource IconConverter}}"
                              Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Metrics Strip: Humidity • Wind • Precipitation -->
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Nem (Humidity) -->
                    <Border Grid.Column="0" Background="#0CFFFFFF" CornerRadius="6" Padding="6,5">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoDrop}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtHumidityLabel" Text="Nem" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Weather.HumidityFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Rüzgar (Wind) -->
                    <Border Grid.Column="2" Background="#0CFFFFFF" CornerRadius="6" Padding="6,5">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoWind}" Fill="{StaticResource AccentGreenBrush}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtWindLabel" Text="Rüzgar" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Weather.WindSpeedFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Yağış (Precipitation) -->
                    <Border Grid.Column="4" Background="#0CFFFFFF" CornerRadius="6" Padding="6,5">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoDrop}" Fill="{StaticResource PriceBrush}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtPrecipLabel" Text="Yağış" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Weather.PrecipitationFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Background="{StaticResource DividerBrush}" Margin="0,0,0,8" />

                <!-- 3-Day Forecast Strip -->
                <ItemsControl ItemsSource="{Binding Weather.ForecastDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Padding="4,2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DayName}" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconConverter}}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,3,0,3" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TempRangeFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

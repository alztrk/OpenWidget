<UserControl x:Class="OpenWidget.Widgets.HardwareWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenWidget.Converters"
             Margin="0,0,0,12"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconConverter" />

        <DataTemplate x:Key="GadgetRowTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2.5" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Path Grid.Column="0"
                          Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                          Fill="{StaticResource TextMutedBrush}"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <!-- Component Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0" />

                    <!-- Price -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding PriceFormatted}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource PriceBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="4,0,4,6">
            <TextBlock x:Name="TxtHardwareTitle"
                       Text="Donanım"
                       HorizontalAlignment="Left"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Specs.TotalPriceFormatted}"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentGreenBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Specs.CoreSystem}"
                      ItemTemplate="{StaticResource GadgetRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Specs.Storage}"
                      ItemTemplate="{StaticResource GadgetRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Specs.Peripherals}"
                      ItemTemplate="{StaticResource GadgetRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Specs.CoolingAndPower}"
                      ItemTemplate="{StaticResource GadgetRowTemplate}" />
        <ItemsControl ItemsSource="{Binding Specs.Accessories}"
                      ItemTemplate="{StaticResource GadgetRowTemplate}" />
    </StackPanel>
</UserControl>

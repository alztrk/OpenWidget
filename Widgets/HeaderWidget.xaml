<UserControl x:Class="OpenWidget.Widgets.HeaderWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,12">
    <DockPanel>
        <TextBlock Text="{Binding Finance.WeatherText}"
                   DockPanel.Dock="Left"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />

        <TextBlock Text="{Binding Telemetry.UptimeText, StringFormat='Açık: {0}'}"
                   DockPanel.Dock="Right"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
    </DockPanel>
</UserControl>

<UserControl x:Class="OpenWidget.Widgets.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,12">

    <UserControl.Resources>
        <Style x:Key="MediaControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SectionBgBrush}"
            BorderBrush="{StaticResource SectionBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Music Icon -->
            <Path Grid.Column="0"
                  Data="{StaticResource GeoMusic}"
                  Fill="{StaticResource AccentBrush}"
                  Stretch="Uniform"
                  Width="13" Height="13"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left" />

            <!-- Song Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="TxtTitle"
                           Text="Medya Oynatılıyor"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtArtist"
                           Text="Bilinmeyen Sanatçı"
                           FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,1,0,0" />
            </StackPanel>

            <!-- Media Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPrev"
                        Style="{StaticResource MediaControlBtn}"
                        Width="22" Height="22"
                        ToolTip="Önceki Parça"
                        Click="BtnPrev_Click">
                    <Path Data="{StaticResource GeoPrevious}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="9" Height="9" />
                </Button>

                <Button x:Name="BtnPlayPause"
                        Width="24" Height="24"
                        Background="#2538BDF8"
                        BorderBrush="#4038BDF8"
                        BorderThickness="1"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Oynat / Duraklat"
                        Click="BtnPlayPause_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="pbd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pbd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path x:Name="PathPlayPause"
                          Data="{StaticResource GeoPlay}"
                          Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform" Width="9" Height="9" />
                </Button>

                <Button x:Name="BtnNext"
                        Style="{StaticResource MediaControlBtn}"
                        Width="22" Height="22"
                        ToolTip="Sonraki Parça"
                        Click="BtnNext_Click">
                    <Path Data="{StaticResource GeoNext}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="9" Height="9" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>